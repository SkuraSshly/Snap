<Window x:Class="Velos.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Velos.UI"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Velos 设置" Icon="Assets/Velos.ico" Width="800" Height="600"
        WindowStyle="None"
        MinWidth="800" MinHeight="600" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Foreground="{DynamicResource Ink}"
        PreviewKeyDown="RecordKey" PreviewKeyUp="ReleaseRecordedModifier" Deactivated="WindowDeactivated">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0"
                        CornerRadius="16" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ui:Keycaps x:Key="Keycaps" />
    <DataTemplate x:Key="KeycapTemplate">
      <ItemsControl ItemsSource="{Binding Converter={StaticResource Keycaps}}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
          <Border Background="{DynamicResource KeycapEdge}" CornerRadius="5" Padding="0,0,0,2" Margin="2,0">
            <Border Background="{DynamicResource KeycapFace}" CornerRadius="5" Padding="6,3" BorderBrush="{DynamicResource Hairline}" BorderThickness="0.5">
              <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" />
            </Border>
          </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>
    <Style x:Key="KeyboardFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate>
      <Border CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource Focus}" Margin="-2" />
    </ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="SwitchKeyboardFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate>
      <Border CornerRadius="13" BorderThickness="1.5" BorderBrush="{DynamicResource Apricot}" Opacity="0.7" Margin="-3" />
    </ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="SettingsCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="14" /><Setter Property="Background" Value="{DynamicResource Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" /><Setter Property="BorderThickness" Value="0.5" />
      <Setter Property="Effect" Value="{DynamicResource CardShadow}" />
    </Style>
    <Style x:Key="WindowButton" TargetType="Button">
      <Setter Property="Width" Value="42" /><Setter Property="Height" Value="32" /><Setter Property="Margin" Value="2,0,0,0" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" CornerRadius="8">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Track}" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Hairline}" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#ED5E4D" /><Setter Property="Foreground" Value="White" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#D84E3F" /><Setter Property="Foreground" Value="White" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Item" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Apricot}" /><Setter Property="Foreground" Value="White" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="FontSize" Value="12" /><Setter Property="Height" Value="26" /><Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource Track}" CornerRadius="13" Padding="9,2">
              <DockPanel><Path DockPanel.Dock="Right" Data="M 0,0 L 3,3 L 6,0" Width="7" Height="4" Stroke="{DynamicResource Ink}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource Ink}" />
              </DockPanel>
            </Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="9" Padding="4" MinWidth="{TemplateBinding ActualWidth}">
              <ScrollViewer MaxHeight="320" CanContentScroll="True" Focusable="False" IsTabStop="False" FocusVisualStyle="{x:Null}"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Margin" Value="0,4,2,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb MinHeight="24">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{DynamicResource Secondary}" CornerRadius="3" Opacity="0.4" Margin="1,0" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="7,0,0,7" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Navigation" TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Tile" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                    BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Track}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{StaticResource SwitchKeyboardFocus}" />
      <Setter Property="ui:WarmMotion.ToggleSwitch" Value="True" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="21" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
              <Grid>
                <Border x:Name="TrackBorder" CornerRadius="10.5" Background="{DynamicResource Track}" />
                <Border x:Name="TrackAccent" CornerRadius="10.5" Opacity="0">
                  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#D9F5945C" /><GradientStop Color="#FFF5945C" Offset="1" /></LinearGradientBrush></Border.Background>
                </Border>
                <Ellipse x:Name="Knob" Fill="White" Width="17" Height="17" Margin="2" HorizontalAlignment="Left">
                  <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                  <Ellipse.Effect><DropShadowEffect Color="Black" Opacity="0.18" BlurRadius="3" ShadowDepth="1" Direction="270" /></Ellipse.Effect>
                </Ellipse>
              </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PillButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
      <Setter Property="ui:WarmMotion.Enabled" Value="True" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="11,1" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="{DynamicResource Track}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Pill" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="15" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Apricot}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Hairline}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="Effect" Value="{DynamicResource BadgeShadow}" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="0,0,11,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BadgeGlyph" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
    </Style>
  </Window.Resources>
  <Grid x:Name="WindowRoot" Background="{DynamicResource Wash}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="196" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Rectangle Grid.ColumnSpan="2" Width="510" Height="510" HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,-255,-130,0" Fill="{DynamicResource ApricotGlow}" IsHitTestVisible="False" />
    <Rectangle Grid.ColumnSpan="2" Width="440" Height="440" HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Margin="-120,0,0,-235" Fill="{DynamicResource CoralGlow}" IsHitTestVisible="False" />
    <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0.5,0">
      <StackPanel Margin="10,48,10,0">
        <StackPanel Orientation="Horizontal" Margin="10,0,0,14">
          <Image x:Name="BrandIcon" Width="104" Height="44" Stretch="Uniform" StretchDirection="DownOnly"
                 HorizontalAlignment="Left" AutomationProperties.Name="Velos" />
        </StackPanel>
        <Grid>
        <Border Height="36" VerticalAlignment="Top" CornerRadius="10" Background="{DynamicResource Apricot}" Effect="{DynamicResource NavigationShadow}" IsHitTestVisible="False">
          <Border.RenderTransform><TranslateTransform x:Name="NavigationOffset" /></Border.RenderTransform>
        </Border>
        <StackPanel>
        <RadioButton x:Name="GeneralTab" GroupName="Settings" Style="{StaticResource Navigation}"
                     AutomationProperties.Name="通用" Checked="ShowGeneral" />
        <RadioButton x:Name="ScreenshotTab" GroupName="Settings" Style="{StaticResource Navigation}"
                     AutomationProperties.Name="截图" Checked="ShowScreenshot" />
        <RadioButton x:Name="RecordingTab" GroupName="Settings" Style="{StaticResource Navigation}"
                     AutomationProperties.Name="录屏" Checked="ShowRecording" />
        <RadioButton x:Name="TranslationTab" GroupName="Settings" Style="{StaticResource Navigation}"
                     AutomationProperties.Name="截屏翻译" Checked="ShowTranslation" />
        <RadioButton x:Name="HotkeysTab" GroupName="Settings" Style="{StaticResource Navigation}"
                     AutomationProperties.Name="快捷键" Checked="ShowHotkeys" />
        </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
    <DockPanel Grid.Column="1">
      <Grid DockPanel.Dock="Top" Height="56">
        <TextBlock x:Name="PageTitle" FontSize="20" FontWeight="Bold" Margin="28,0,160,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </Grid>
      <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Focusable="False" IsTabStop="False" FocusVisualStyle="{x:Null}">
      <StackPanel Margin="26,4,26,26">
        <StackPanel x:Name="GeneralPage">
          <TextBlock Text="启动" Style="{StaticResource SectionLabel}" />
          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <Grid Margin="13,9,13,9" MinHeight="28">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Badge}" Background="{DynamicResource ApricotBadge}">
                  <ContentControl x:Name="LoginIcon" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="登录时自动启动 Velos" FontWeight="Medium" VerticalAlignment="Center" />
                <CheckBox x:Name="LoginSwitch" Grid.Column="2" Style="{StaticResource Switch}"
                          AutomationProperties.Name="登录时自动启动 Velos" Click="ToggleLogin" />
              </Grid>
              <Border Height="0.5" Margin="50,0,0,0" Background="{DynamicResource Hairline}" />
              <Grid Margin="13,9,13,9" MinHeight="28">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Badge}" Background="#FF9E7357">
                  <ContentControl x:Name="TrayIcon" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                  <TextBlock Text="显示托盘图标" FontWeight="Medium" />
                  <TextBlock Text="隐藏后仍可使用快捷键。再次打开 Velos 即可回到设置。" Style="{StaticResource Caption}" />
                </StackPanel>
                <CheckBox x:Name="TraySwitch" Grid.Column="2" Style="{StaticResource Switch}"
                          AutomationProperties.Name="显示托盘图标" Click="ToggleTray" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="ScreenshotPage" Visibility="Collapsed" />
        <StackPanel x:Name="RecordingPage" Visibility="Collapsed" />
        <StackPanel x:Name="TranslationPage" Visibility="Collapsed" />
        <StackPanel x:Name="HotkeysPage" Visibility="Collapsed">
          <TextBlock Text="全局快捷键" Style="{StaticResource SectionLabel}" />
          <Border Style="{StaticResource SettingsCard}">
            <ItemsControl x:Name="HotkeyRows">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="13,8" MinHeight="32">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Badge}" Background="{Binding Tint}">
                      <ContentControl Content="{Binding Symbol}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                      <TextBlock Text="{Binding Title}" FontWeight="Medium" />
                      <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                 Foreground="{DynamicResource Warning}" Visibility="{Binding StatusVisibility}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="恢复默认" Visibility="{Binding RestoreVisibility}" Tag="{Binding Action}"
                              Style="{StaticResource PillButton}" Margin="0,0,8,0" Click="RestoreHotkey"
                              AutomationProperties.Name="{Binding RestoreName}" />
                      <Button x:Name="HotkeyRecorder" Content="{Binding Label}" Tag="{Binding Action}" MinWidth="144" MaxWidth="270"
                              ContentTemplate="{StaticResource KeycapTemplate}"
                              Style="{StaticResource PillButton}" FontWeight="SemiBold" Click="BeginRecording"
                              AutomationProperties.Name="{Binding AutomationName}" LostKeyboardFocus="CancelOnFocusLost" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <TextBlock Text="点击快捷键框后按新组合键，按 Esc 取消。请包含 Ctrl 或 Alt，F1–F20 可单独使用（F12 由 Windows 保留）。"
                     Style="{StaticResource Caption}" Margin="7,8,7,0" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Foreground="{DynamicResource Warning}"
                   Margin="7,12,7,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </ScrollViewer>
    </DockPanel>
    <StackPanel x:Name="WindowControls" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,6,8,0" Panel.ZIndex="10" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}" Click="MinimizeSettings" AutomationProperties.Name="最小化" ToolTip="最小化" />
      <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Click="MaximizeSettings" AutomationProperties.Name="最大化" ToolTip="最大化" />
      <Button x:Name="CloseButton" Style="{StaticResource CloseWindowButton}" Click="CloseSettings" AutomationProperties.Name="关闭设置" ToolTip="关闭设置" />
    </StackPanel>
  </Grid>
</Window>
