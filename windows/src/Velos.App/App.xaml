<Application x:Class="Velos.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="UI/WarmMenus.xaml" />
    </ResourceDictionary.MergedDictionaries>
      <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control">
        <Setter Property="Template"><Setter.Value><ControlTemplate>
          <Border Margin="-2" CornerRadius="8" BorderBrush="#FFF5945C" BorderThickness="1.5" Opacity="0.7" />
        </ControlTemplate></Setter.Value></Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
